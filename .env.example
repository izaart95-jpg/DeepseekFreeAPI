DEEPSEEK_TOKEN=eyk....
PROXY_API_KEY=Waguri
DEBUG=true
AGENT_MODE=true

# Stateless (history=false) session flow — default is "stealth":
#   one lazily-created session reused via /chat/edit_message, rotated after
#   the edit budget runs out (anti-detection: no boot burst, no churn).
# SESSION_FLOW=stealth
# SESSION_FLOW=pool    # legacy pre-warmed session batch
# SESSION_FLOW=sync    # legacy one-session-per-request
# --legacy-pool / --sync-mode flags do the same
